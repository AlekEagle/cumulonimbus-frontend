{
  "name": "cumulonimbus-frontend",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "license": "GNU-GPL-3.0",
  "scripts": {
    "live-prod": "vite --host --port 6173 -c vite.config.ts",
    "live-ptb": "vite --host --port 4173 -c vite.config.ptb.ts",
    "live-dev": "vite --host --port 5173 -c vite.config.development.ts",
    "build-prod": "vue-tsc --noEmit && vite build",
    "build-ptb": "vue-tsc --noEmit && vite build -c vite.config.ptb.ts",
    "build-dev": "vue-tsc --noEmit && vite build -c vite.config.development.ts",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@vueuse/components": "^13.9.0",
    "@vueuse/core": "^13.9.0",
    "cumulonimbus-wrapper": "6.2.0",
    "ms": "^2.1.3",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.21",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^24.3.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "terser": "^5.44.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.0.7"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
